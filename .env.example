# =============================================================================
# contract-guard-ai —— RAG 模块配置（rag_core.config.RagSettings）
# 复制为 .env 后按需修改；全部变量均为可选，默认值即可离线跑通。
# 前缀固定为 CG_RAG_，与项目既有 CG_ 约定一致。
# =============================================================================

# -----------------------------------------------------------------------------
# 向量库（默认 inmemory：纯 Python，零依赖，离线可用）
#   inmemory —— 进程内暴力余弦检索（默认 / 单测）
#   qdrant   —— 真实向量库，配合下面的 CG_RAG_QDRANT_MODE 使用
#   milvus   —— 备选向量库（B 组可扩展性支线），配合下面的 CG_RAG_MILVUS_* 使用
# -----------------------------------------------------------------------------
CG_RAG_VECTOR_STORE=inmemory
# server（连 docker-compose 的 6333）| local_memory（:memory:）| local_path（落盘）
CG_RAG_QDRANT_MODE=local_memory
CG_RAG_QDRANT_URL=http://localhost:6333
CG_RAG_QDRANT_LOCAL_PATH=./data/qdrant
CG_RAG_QDRANT_API_KEY=
CG_RAG_COLLECTION=contract_clauses
CG_RAG_VECTOR_DIM=1024

# -----------------------------------------------------------------------------
# Milvus（备选向量库；**仅当 CG_RAG_VECTOR_STORE=milvus 时生效**）
#   下面整段默认注释掉 —— 默认路径（inmemory）不需要任何外部服务，保持离线可跑。
#   ⚠️ Windows 只能用 server 模式（Milvus Lite 官方支持以 Linux/macOS 为主）；
#      服务未起时 factory 会在构造客户端时抛 StoreUnavailableError（构造即建连）。
#   起服务见 docker/docker-compose.yml（T-A3 / 0-C2）
# -----------------------------------------------------------------------------
# server（推荐）| lite（Linux/macOS 本地文件）
# CG_RAG_MILVUS_MODE=server
# CG_RAG_MILVUS_URI=http://localhost:19530
# CG_RAG_MILVUS_TOKEN=
# CG_RAG_MILVUS_DB_NAME=default
# CG_RAG_MILVUS_TIMEOUT_S=5.0

# -----------------------------------------------------------------------------
# Embedding（默认 hash：离线哈希伪向量，无需外网 / GPU / API Key）
#   hash —— 确定性伪向量（默认，仅用于跑通链路与单测，语义表达力有限）
#   http —— TEI 或 OpenAI 兼容接口（生产推荐 BAAI/bge-m3，1024 维）
# -----------------------------------------------------------------------------
CG_RAG_EMBED_MODE=hash
CG_RAG_EMBED_BASE_URL=http://localhost:8080
CG_RAG_EMBED_API_KEY=none
CG_RAG_EMBED_MODEL=BAAI/bge-m3
CG_RAG_EMBED_BATCH_SIZE=32
CG_RAG_EMBED_TIMEOUT_MS=3000
# TEI 用 /embed；OpenAI 兼容（如 vLLM / OneAPI）用 /v1/embeddings
CG_RAG_EMBED_PATH=/v1/embeddings

# -----------------------------------------------------------------------------
# 检索与融合（Phase 2 起生效）
# -----------------------------------------------------------------------------
CG_RAG_BM25_DIR=./data/bm25
CG_RAG_SPARSE_TOP=20
CG_RAG_DENSE_TOP=20
CG_RAG_RRF_K=60

# -----------------------------------------------------------------------------
# Reranker（默认 noop：恒等透传，Phase 1 不启用精排）
#   noop  —— 恒等透传（默认）
#   local —— 本地 CrossEncoder（需 sentence-transformers + torch，约 2GB）
#   http  —— 远程 rerank 服务（Phase 2/3）
# -----------------------------------------------------------------------------
CG_RAG_RERANK_ENABLED=true
CG_RAG_RERANK_MODE=noop
CG_RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CG_RAG_RERANK_HTTP_URL=
CG_RAG_RERANK_THRESHOLD=0.35
CG_RAG_RERANK_TOP_N=5

# -----------------------------------------------------------------------------
# 预算、降级与默认策略
# -----------------------------------------------------------------------------
CG_RAG_MAX_CONTEXT_TOKENS=3000
CG_RAG_MAX_QUERY_CHARS=2000
CG_RAG_TIMEOUT_MS=3000
CG_RAG_MAX_RETRIES=3
CG_RAG_SCORE_THRESHOLD=0.35
# DENSE_ONLY（Phase 1）| SPARSE_ONLY（调试）| HYBRID_RRF（Phase 2+）
# ⚠️ 注意与 RAGQueryRequest.strategy 的默认值不同（C2 已决策保持现状）：
#   请求侧默认 HYBRID_RRF = "能力声明"（本系统支持混合检索）
#   此处默认 DENSE_ONLY   = "当前实际启用"（BM25 未接入前只能用稠密）
#   二者不一致是刻意的：它保证 Phase 1 离线可跑（无需 BM25 服务）。
#   T03 完成（BM25Store 接入）后，生产环境请将本值改为 HYBRID_RRF。
#   另：strategy != DENSE_ONLY 且 sparse_store is None 时，RAGService 会
#   自动降级为 DENSE_ONLY 并追加 warning，属正常行为。
# ✅ T-A7（2026-09-21）：本值**已接线** —— 作为服务级默认策略生效（请求未显式传 strategy 时）
CG_RAG_STRATEGY=DENSE_ONLY

# -----------------------------------------------------------------------------
# 缓存与日志
# -----------------------------------------------------------------------------
# ⚠️ 已登记未实现：当前无热 Query 缓存（T-A7 显式登记，保留以免丢失需求记录）
CG_RAG_CACHE_TTL_S=300
# ✅ 仍有效：由 cg_observability/logger.py 直接读取（不走 RagSettings；T-A7 已删除重复字段）
CG_RAG_LOG_LEVEL=INFO

# ============================================================================
# OCR / 文档解析（模块 3）—— 唯一处：packages/doc-processor/doc_processor/config.py
# 前缀固定 CG_OCR_。以下**全部是注释示例**，按需取消注释；不写真实绝对路径。
# ============================================================================
# CG_OCR_ENGINE=auto                  # auto | rapid | paddle（auto 按可用性择一）
# CG_OCR_NATIVE_TEXT_MIN_CHARS=50     # 采样页平均可抽字符 ≥ 此值 → 走 PDF_NATIVE
# CG_OCR_ROUTE_SAMPLE_PAGES=3         # 分流采样页数
# CG_OCR_RENDER_DPI=200               # PDF → 图像 DPI（坐标归一必须用它）
# CG_OCR_IMAGE_DPI=72                 # 独立图片的 DPI 假设
# CG_OCR_LANG=ch
# CG_OCR_MIN_CONFIDENCE=0.5           # 低于此值的 OCR 结果丢弃
# CG_OCR_MODEL_DIR=                   # 离线演示机填写模型目录
# CG_OCR_TIMEOUT_S=60                 # 单页 OCR 超时
# CG_OCR_SEAL_MIN_AREA_RATIO=0.0005   # 印章红色区域最小面积占比
# CG_OCR_SEAL_RING_STEPS=360          # 印章极坐标展开采样角数

# ============================================================================
# LLM（模块 2）—— 唯一处：packages/ai-engine/ai_engine/llm/（见 codex/2-2，T-B1）
# 决策：D2-a `langchain-openai` + `ChatOpenAI`；D2-d DeepSeek `deepseek-flash`
# 统一接口多端（D4-a 同源思路）：三家都走 OpenAI 兼容协议，只换 base_url / model / api_key
# ============================================================================
# provider/预设：deepseek → https://api.deepseek.com/v1 ；ollama → http://localhost:11434/v1
CG_LLM_PROVIDER=offline             # offline（默认，离线红线）| deepseek | ollama | openai
CG_LLM_MODEL=deepseek-flash         # deepseek: deepseek-flash | deepseek-v4-pro ；ollama: 如 qwen2.5:7b
CG_LLM_BASE_URL=                    # 留空走 provider 预设；ollama 填 http://localhost:11434/v1
CG_LLM_API_KEY=                     # ⚠️ 真实密钥只放 .env（不入库），这里留空
CG_LLM_TEMPERATURE=0
# ⚠️ reasoning 模型（deepseek-flash）的 reasoning_tokens 先吃这个额度：给小了 content 会是空串（实测 16 → 空）
CG_LLM_MAX_TOKENS=2048
CG_LLM_TIMEOUT_S=60
# ⚠️ 实测：DeepSeek 的 response_format={"type":"json_schema"} 不可用（400）
#    → 结构化输出必须走 function calling；默认用 json_mode 以避开该 400
CG_LLM_JSON_MODE=json_mode          # json_mode（默认）| json_schema | none

# -----------------------------------------------------------------------------
# 语义服务（模块 1，D4-a：统一 HTTP + 配置区分多端；**默认保持离线**）
# 切到 ollama / 云端只改这几行，代码零改动（HttpEmbedder / HttpReranker 已实现）
# -----------------------------------------------------------------------------
# CG_RAG_EMBED_MODE=http
# CG_RAG_EMBED_BASE_URL=http://localhost:11434/v1
# CG_RAG_EMBED_PATH=/embeddings
# CG_RAG_EMBED_MODEL=bge-m3
# CG_RAG_EMBED_API_KEY=ollama
# CG_RAG_RERANK_MODE=http
# CG_RAG_RERANK_HTTP_URL=http://localhost:11434/v1
# CG_RAG_RERANK_PATH=/rerank
