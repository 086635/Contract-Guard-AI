# web-ui 镜像：前端构建 + nginx 托管（SPA history 回退由 web-nginx.conf 处理）
FROM node:20-slim AS build
WORKDIR /app
RUN npm install -g pnpm
COPY apps/web-ui/package.json ./
RUN pnpm config set strict-dep-builds false \
    && pnpm install
COPY apps/web-ui/index.html apps/web-ui/postcss.config.js apps/web-ui/tailwind.config.js apps/web-ui/tsconfig.json apps/web-ui/tsconfig.app.json apps/web-ui/tsconfig.node.json apps/web-ui/vite.config.ts ./
COPY apps/web-ui/src ./src
COPY apps/web-ui/public ./public
RUN pnpm build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/web-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]