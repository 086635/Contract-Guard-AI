# =============================================================================
# 生产环境变量模板（C66 · T-D7-8）——**只放占位，仓库里不得出现任何真实 secret**
#
# 用法（部署机上）：
#   1) 复制为受控 env 文件并收紧权限：
#        cp .env.production.example /etc/contract-guard/app.env && chmod 600 /etc/contract-guard/app.env
#   2) **推荐**改用 Docker secret 文件：只填下面的 CG_*_FILE，对应内联值留空；
#      secret 文件本身由部署方创建（权限 600），compose 叠加见 docker/docker-compose.prod.yml。
#   3) 部署前自检（只输出字段名与原因，不回显任何值）：
#        python -m app.config --check
# =============================================================================

CG_RUNTIME_ENV=production

# -----------------------------------------------------------------------------
# Secret 注入路径（推荐）：值为容器内挂载路径，例如 /run/secrets/cg_jwt_secret
# 优先级：文件 > 显式环境变量 > 默认值；文件不可读或为空 → 启动失败
# -----------------------------------------------------------------------------
CG_JWT_SECRET_FILE=
CG_POSTGRES_PASSWORD_FILE=
CG_MINIO_ACCESS_KEY_FILE=
CG_MINIO_SECRET_KEY_FILE=
CG_LLM_API_KEY_FILE=

# -----------------------------------------------------------------------------
# 数据库（若用 CG_POSTGRES_PASSWORD_FILE，则 DSN 里的口令会被文件值覆盖）
# -----------------------------------------------------------------------------
CG_POSTGRES_DSN=postgresql+asyncpg://<user>:<from-secret-file>@<db-host>:5432/<database>

# -----------------------------------------------------------------------------
# 对象存储（生产必须非 localhost 的 public endpoint，且禁用默认口令）
# -----------------------------------------------------------------------------
CG_MINIO_ENDPOINT=<minio-internal:9000>
CG_MINIO_PUBLIC_ENDPOINT=<minio.example.com:9000>
CG_MINIO_ACCESS_KEY=<from-secret-file>
CG_MINIO_SECRET_KEY=<from-secret-file>
CG_MINIO_BUCKET=contracts
CG_MINIO_SECURE=true

# -----------------------------------------------------------------------------
# 认证（JWT secret 必须非默认值；建议用 CG_JWT_SECRET_FILE 注入）
# -----------------------------------------------------------------------------
CG_JWT_SECRET=<from-secret-file>
CG_JWT_ACCESS_TTL_SECONDS=900
CG_JWT_REFRESH_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# 真实 LLM（生产禁止 offline；必须显式 allow_external_data）
# -----------------------------------------------------------------------------
CG_LLM_PROVIDER=<deepseek|openai|ollama>
CG_LLM_MODEL=<model-name>
CG_LLM_BASE_URL=<https://api.example.com/v1>
CG_LLM_API_KEY=<from-secret-file>
CG_LLM_ALLOW_EXTERNAL_DATA=true

# -----------------------------------------------------------------------------
# 语义检索（生产禁止 hash embedding / noop reranker）
# -----------------------------------------------------------------------------
CG_RAG_EMBED_MODE=http
CG_RAG_EMBED_BASE_URL=<https://embed.example.com/v1/embeddings>
CG_RAG_EMBED_API_KEY=<from-controlled-env>
CG_RAG_RERANK_ENABLED=true
CG_RAG_RERANK_MODE=http
CG_RAG_RERANK_HTTP_URL=<https://rerank.example.com/rerank>
CG_RAG_RERANK_API_KEY=<from-controlled-env>
CG_RAG_VECTOR_STORE=qdrant
CG_RAG_QDRANT_MODE=server
CG_RAG_QDRANT_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# 上传内容扫描（C57）：生产必须 clamav
# -----------------------------------------------------------------------------
CG_UPLOAD_AV_MODE=clamav
